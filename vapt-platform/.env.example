# =============================================================================
# VAPT Platform - Environment Configuration
# Copy this file to .env and fill in the required secrets
# =============================================================================

# General
APP_NAME="VAPT Platform"
APP_ENV=development
APP_LOG_LEVEL=info
APP_TIMEZONE=UTC

# Postgres
POSTGRES_USER=vapt
POSTGRES_PASSWORD=changeme_postgres_pw
POSTGRES_DB=vapt
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vapt:changeme_postgres_pw@postgres:5432/vapt

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3
MINIO_ROOT_USER=vapt
MINIO_ROOT_PASSWORD=changeme_minio_pw
MINIO_BUCKET=vapt-evidence
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

# Auth / JWT
JWT_SECRET=change_me_long_random_string_at_least_64_chars_xxxxxxxxxxxxxxxxxxxx
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
TOTP_ISSUER=VAPT-Platform
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Rate limiting / lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Caddy
CADDY_DOMAIN=localhost
CADDY_EMAIL=admin@example.com

# AI / Model provider
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-change-me
LLM_MODEL=claude-sonnet-4-5
LLM_BASE_URL=
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.2

# MCP server (internal)
MCP_SERVER_URL=http://mcp:8081

# Backup
BACKUP_PATH=/var/backups/vapt
BACKUP_RETENTION_DAYS=30

# Ingestion poll interval (for drop location mode)
INGESTION_POLL_INTERVAL_SEC=60
INGESTION_DROP_PATH=/var/ingest
